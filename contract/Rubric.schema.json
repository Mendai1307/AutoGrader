{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "autograder/Rubric/1.1.0",
  "title": "AutoGrader Rubric",
  "description": "AutoGrader 评分量规契约（冻结版 1.1.0）。档位模型为 v0.1 的 levels[]{level,label,criterion,scoreRatio}，即以「语义等级 + 得分系数 + 可判定判据」表达档位，取代数值区间 bands[]{from,to}。口径说明见 docs/contract.md。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "items"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/RubricItem" }
    }
  },
  "$defs": {
    "ScoreLevel": {
      "type": "string",
      "enum": ["excellent", "meeting", "partial", "notMet"]
    },
    "RubricItemLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "label", "criterion", "scoreRatio"],
      "properties": {
        "level": { "$ref": "#/$defs/ScoreLevel" },
        "label": { "type": "string", "minLength": 1 },
        "criterion": { "type": "string", "minLength": 1 },
        "scoreRatio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "RubricItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "weight",
        "maxScore",
        "evidenceRequirement",
        "levels",
        "deductionNotes"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "minimum": 0, "maximum": 100 },
        "maxScore": { "type": "number", "minimum": 0, "exclusiveMinimum": 0 },
        "evidenceRequirement": { "type": "string", "minLength": 1 },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/RubricItemLevel" }
        },
        "deductionNotes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
